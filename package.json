{
  "name": "synestra",
  "productName": "SYNESTRA",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run type-check && node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:visuals": "node scripts/phase2-smoke.mjs",
    "test:scenes": "node scripts/phase25-smoke.mjs",
    "test:art": "node scripts/art-review.mjs",
    "test:rendering": "node scripts/phase25-smoke.mjs --phase3",
    "test:milkdrop": "node scripts/phase4-smoke.mjs",
    "presets:compile": "node scripts/compile-milkdrop-presets.mjs",
    "test:milkdrop-art": "node scripts/milkdrop-art.mjs",
    "test:intelligence": "node scripts/phase5-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "butterchurn": "2.6.7",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.synestra.player",
    "productName": "SYNESTRA",
    "directories": {
      "output": "release/1.0.1"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "artifactName": "SYNESTRA-Setup-${version}-x64.${ext}",
    "extraFiles": [
      {
        "from": "docs/releases/1.0.1.md",
        "to": "README-SYNESTRA.md"
      },
      {
        "from": "public/licenses",
        "to": "licenses"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "SYNESTRA desktop MP3 player and music visualizer",
  "author": "scryingorb",
  "repository": {
    "type": "git",
    "url": "https://github.com/scryingorb/SYNESTRA.git"
  }
}
